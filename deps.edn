{:deps {org.clojure/clojure {:mvn/version "1.12.3"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1070"}
        com.layerware/hugsql {:mvn/version "0.5.3"}
        org.clojure/java.jdbc {:mvn/version "0.7.12"}
        org.xerial/sqlite-jdbc {:mvn/version "3.46.0.0"}
        org.postgresql/postgresql {:mvn/version "42.7.5"}
        org.hsqldb/hsqldb {:mvn/version "2.7.2"}
        com.h2database/h2 {:mvn/version "2.3.232"}
        

        ;; wire composure
        org.duct-framework/main {:mvn/version "0.4.4"}
        org.duct-framework/test {:mvn/version "0.1.0"}
        com.stuartsierra/component {:mvn/version "1.2.0"}

        ;; testing and validation
        metosin/malli {:mvn/version "0.20.0-alpha3"}
        prismatic/schema {:mvn/version "1.4.1"}}
 :aliases {:duct {:extra-deps {nrepl/nrepl {:mvn/version "1.1.0"}
                               cider/cider-nrepl {:mvn/version "0.47.1"}}
                  :main-opts ["-m" "duct.main"]}
           :repl {:extra-deps {nrepl/nrepl {:mvn/version "1.1.0"}
                               cider/cider-nrepl {:mvn/version "0.47.1"}}
                  :main-opts ["-m" "nrepl.cmdline"
                              "--middleware" "[cider.nrepl/cider-middleware]"]}
           :dev {:extra-deps {org.clojure/tools.namespace {:mvn/version "1.5.0"}}
                 :extra-paths ["src"]}}}